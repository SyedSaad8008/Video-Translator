<resources>
    <!--
        Pure Jetpack Compose app — all Material3 theming is done in Kotlin.
        This XML theme just sets the window background before Compose renders.
        Using Theme.AppCompat as the base (always available via appcompat dependency).
    -->
    <style name="Theme.VideoTranslator" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#0A0A1A</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
    </style>
</resources>